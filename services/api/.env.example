# Local development only. Copy to services/api/.env; never commit the copied file.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://aaraagate:aaraagate_dev@localhost:5432/aaraagate
REDIS_URL=redis://localhost:6379
CORS_ALLOWED_ORIGINS=http://localhost:3001

# Provider-neutral release identification. Deployment automation should set these
# from the immutable application version and commit being deployed.
APP_VERSION=dev
GIT_SHA=unknown

# Local development can use the in-memory OTP fallback. Production must use a
# configured provider and secret values from the deployment secret store.
OTP_DELIVERY_PROVIDER=

# Provider-neutral accounting connector bridge.
# Keep auto-delivery disabled until the bridge endpoint, authentication and
# downstream accounting workflow have been validated for the target environment.
ACCOUNTING_CONNECTOR_PROVIDER=configured-http
ACCOUNTING_CONNECTOR_BASE_URL=
ACCOUNTING_CONNECTOR_API_KEY=
ACCOUNTING_CONNECTOR_AUTO_DELIVER=false
# Minimum runtime interval is 60000 ms; default is 300000 ms (5 minutes).
ACCOUNTING_CONNECTOR_INTERVAL_MS=300000
# Failed transport attempts become terminal after this many attempts; default 5.
ACCOUNTING_CONNECTOR_MAX_ATTEMPTS=5
