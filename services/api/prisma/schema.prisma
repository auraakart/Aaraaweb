generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String              @id @default(uuid()) @db.Uuid
  phone       String              @unique
  email       String?             @unique
  name        String?
  status      UserStatus          @default(ACTIVE)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  memberships SocietyMembership[]
  unitLinks   UnitResident[]
  visitors    Visitor[]
}

model Society {
  id          String              @id @default(uuid()) @db.Uuid
  name        String
  code        String              @unique
  status      SocietyStatus       @default(ACTIVE)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  memberships SocietyMembership[]
  buildings   Building[]
  gates       Gate[]
  unitLinks   UnitResident[]
  visitors    Visitor[]
  visitorPasses VisitorPass[]
}

model SocietyMembership {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  societyId String   @db.Uuid
  role      MembershipRole
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  society   Society  @relation(fields: [societyId], references: [id], onDelete: Cascade)
  @@unique([userId, societyId, role])
  @@index([societyId])
}

model Building {
  id        String   @id @default(uuid()) @db.Uuid
  societyId String   @db.Uuid
  name      String
  code      String
  society   Society  @relation(fields: [societyId], references: [id], onDelete: Cascade)
  units     Unit[]
  @@unique([societyId, code])
}

model Unit {
  id         String         @id @default(uuid()) @db.Uuid
  societyId  String         @db.Uuid
  buildingId String         @db.Uuid
  number     String
  building   Building       @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  residents  UnitResident[]
  visitors   Visitor[]
  @@unique([buildingId, number])
  @@index([societyId])
}

model UnitResident {
  id        String   @id @default(uuid()) @db.Uuid
  societyId String   @db.Uuid
  unitId    String   @db.Uuid
  userId    String   @db.Uuid
  relation  UnitRelation
  primary   Boolean  @default(false)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  society   Society  @relation(fields: [societyId], references: [id], onDelete: Cascade)
  unit      Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([unitId, userId])
  @@index([societyId, unitId])
  @@index([societyId, userId])
}

model Gate {
  id        String   @id @default(uuid()) @db.Uuid
  societyId String   @db.Uuid
  name      String
  code      String
  active    Boolean  @default(true)
  society   Society  @relation(fields: [societyId], references: [id], onDelete: Cascade)
  @@unique([societyId, code])
}

model Visitor {
  id          String   @id @default(uuid()) @db.Uuid
  societyId   String   @db.Uuid
  unitId      String   @db.Uuid
  hostUserId  String   @db.Uuid
  name        String
  phone       String?
  purpose     String?
  status      VisitorStatus @default(PENDING)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  society     Society  @relation(fields: [societyId], references: [id], onDelete: Cascade)
  unit        Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  hostUser    User     @relation(fields: [hostUserId], references: [id], onDelete: Cascade)
  passes      VisitorPass[]
  @@index([societyId, hostUserId])
  @@index([societyId, unitId])
}

model VisitorPass {
  id            String   @id @default(uuid()) @db.Uuid
  societyId     String   @db.Uuid
  visitorId     String   @db.Uuid
  credentialHash String
  validFrom     DateTime
  validUntil    DateTime
  status        VisitorPassStatus @default(ACTIVE)
  checkedInAt   DateTime?
  checkedOutAt  DateTime?
  createdAt     DateTime @default(now())
  society       Society  @relation(fields: [societyId], references: [id], onDelete: Cascade)
  visitor       Visitor  @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  @@index([societyId, status])
  @@index([visitorId])
  @@index([societyId, credentialHash])
}

enum UserStatus { ACTIVE SUSPENDED DELETED }
enum SocietyStatus { ACTIVE SUSPENDED }
enum MembershipRole { SUPER_ADMIN SOCIETY_ADMIN COMMITTEE_MEMBER FACILITY_MANAGER ACCOUNTANT OWNER TENANT FAMILY_MEMBER SECURITY_SUPERVISOR SECURITY_GUARD STAFF VENDOR }
enum UnitRelation { OWNER TENANT FAMILY_MEMBER }
enum VisitorStatus { PENDING APPROVED DENIED CHECKED_IN CHECKED_OUT CANCELLED }
enum VisitorPassStatus { ACTIVE USED EXPIRED REVOKED }
