generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                        String                     @id @default(uuid()) @db.Uuid
  phone                     String                     @unique
  email                     String?                    @unique
  name                      String?
  status                    UserStatus                 @default(ACTIVE)
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  memberships               SocietyMembership[]
  unitOwnerships            UnitOwnership[]
  unitOccupancies           UnitOccupancy[]
  visitors                  Visitor[]
  accessRequests            AccessRequest[]
  serviceBookings           ServiceBooking[]
  serviceRatings            ServiceRating[]
  sessions                  Session[]
  pushDeviceTokens          DevicePushToken[]
  workforceLeavesCreated    WorkforceLeave[]           @relation("WorkforceLeaveCreator")
  workforceRatingsGiven     WorkforceRating[]          @relation("WorkforceRatingAuthor")
  workforceSuspensionEvents WorkforceSuspensionEvent[] @relation("WorkforceSuspensionActor")
  helpdeskTicketsCreated    HelpdeskTicket[]           @relation("HelpdeskTicketCreator")
  helpdeskTicketsAssigned   HelpdeskTicket[]           @relation("HelpdeskTicketAssignee")
  helpdeskActivities        HelpdeskActivity[]
  noticesCreated            Notice[]                   @relation("NoticeCreator")
  noticeEvents              NoticeEvent[]
  sosIncidents              SosIncident[]              @relation("SosResident")
  sosAcknowledgements       SosIncident[]              @relation("SosAcknowledgedBy")
  sosResolutions            SosIncident[]              @relation("SosResolvedBy")
  sosEvents                 SosIncidentEvent[]
  invoicesCreated           MaintenanceInvoice[]       @relation("InvoiceCreator")
  paymentEvents             PaymentEvent[]             @relation("PaymentEventActor")
}

model Society {
  id                   String                     @id @default(uuid()) @db.Uuid
  name                 String
  code                 String                     @unique
  status               SocietyStatus              @default(ACTIVE)
  productTier          ProductTier                @default(STARTER)
  featureOverrides     Json                       @default("{}")
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  memberships          SocietyMembership[]
  buildings            Building[]
  gates                Gate[]
  unitOwnerships       UnitOwnership[]
  unitOccupancies      UnitOccupancy[]
  households           Household[]
  vehicles             HouseholdVehicle[]
  emergencyContacts    EmergencyContact[]
  domesticWorkers      DomesticWorker[]
  workforceAssignments WorkforceAssignment[]
  visitors             Visitor[]
  visitorPasses        VisitorPass[]
  accessRequests       AccessRequest[]
  providerApprovals    ServiceProviderSociety[]
  serviceBookings      ServiceBooking[]
  serviceRatings       ServiceRating[]
  auditEvents          AuditEvent[]
  gateMutations        GateMutationReceipt[]
  sessions             Session[]
  pushDeviceTokens     DevicePushToken[]
  workforceLeaves      WorkforceLeave[]
  workforceRatings     WorkforceRating[]
  workforceSuspensions WorkforceSuspensionEvent[]
  helpdeskTickets      HelpdeskTicket[]
  helpdeskActivities   HelpdeskActivity[]
  notices              Notice[]
  noticeEvents         NoticeEvent[]
  sosIncidents         SosIncident[]
  sosEvents            SosIncidentEvent[]
  maintenanceInvoices  MaintenanceInvoice[]
  payments             Payment[]
  paymentEvents        PaymentEvent[]
}

model SocietyMembership {
  id        String         @id @default(uuid()) @db.Uuid
  userId    String         @db.Uuid
  societyId String         @db.Uuid
  role      MembershipRole
  active    Boolean        @default(true)
  createdAt DateTime       @default(now())
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  society   Society        @relation(fields: [societyId], references: [id], onDelete: Cascade)

  @@unique([userId, societyId, role])
  @@index([societyId])
}

model Building {
  id        String  @id @default(uuid()) @db.Uuid
  societyId String  @db.Uuid
  name      String
  code      String
  society   Society @relation(fields: [societyId], references: [id], onDelete: Cascade)
  units     Unit[]

  @@unique([societyId, code])
}

model Unit {
  id                  String               @id @default(uuid()) @db.Uuid
  societyId           String               @db.Uuid
  buildingId          String               @db.Uuid
  number              String
  building            Building             @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  ownerships          UnitOwnership[]
  occupancies         UnitOccupancy[]
  household           Household?
  visitors            Visitor[]
  accessRequests      AccessRequest[]
  serviceBookings     ServiceBooking[]
  helpdeskTickets     HelpdeskTicket[]
  sosIncidents        SosIncident[]
  maintenanceInvoices MaintenanceInvoice[]

  @@unique([buildingId, number])
  @@index([societyId])
}

/// Legal/property relationship. Ownership does not imply residence, household
/// access, gate notifications or gate approval authority.
model UnitOwnership {
  id            String    @id @default(uuid()) @db.Uuid
  societyId     String    @db.Uuid
  unitId        String    @db.Uuid
  userId        String    @db.Uuid
  verified      Boolean   @default(false)
  ownershipBps  Int       @default(10000)
  effectiveFrom DateTime  @default(now()) @db.Timestamptz(6)
  effectiveTo   DateTime? @db.Timestamptz(6)
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(6)
  society       Society   @relation(fields: [societyId], references: [id], onDelete: Cascade)
  unit          Unit      @relation(fields: [unitId], references: [id], onDelete: Cascade)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([unitId, userId, active])
  @@index([societyId, unitId, active])
  @@index([societyId, userId, active])
}

/// Time-bound physical occupancy. Gate routing and day-to-day household
/// authority are derived from this record, never from ownership alone.
model UnitOccupancy {
  id                      String       @id @default(uuid()) @db.Uuid
  societyId               String       @db.Uuid
  unitId                  String       @db.Uuid
  userId                  String       @db.Uuid
  relation                UnitRelation
  effectiveFrom           DateTime     @default(now()) @db.Timestamptz(6)
  effectiveTo             DateTime?    @db.Timestamptz(6)
  active                  Boolean      @default(true)
  primaryGateContact      Boolean      @default(false)
  gateApprovalEnabled     Boolean      @default(true)
  gateNotificationEnabled Boolean      @default(true)
  escalationOrder         Int          @default(100)
  createdAt               DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt               DateTime     @updatedAt @db.Timestamptz(6)
  society                 Society      @relation(fields: [societyId], references: [id], onDelete: Cascade)
  unit                    Unit         @relation(fields: [unitId], references: [id], onDelete: Cascade)
  user                    User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([unitId, userId, active])
  @@index([societyId, unitId, active, gateNotificationEnabled])
  @@index([societyId, userId, active])
}

model Household {
  id                   String                @id @default(uuid()) @db.Uuid
  societyId            String                @db.Uuid
  unitId               String                @unique @db.Uuid
  displayName          String?
  accessPreferences    Json                  @default("{}")
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  society              Society               @relation(fields: [societyId], references: [id], onDelete: Cascade)
  unit                 Unit                  @relation(fields: [unitId], references: [id], onDelete: Cascade)
  vehicles             HouseholdVehicle[]
  emergencyContacts    EmergencyContact[]
  workforceAssignments WorkforceAssignment[]

  @@index([societyId])
}

model HouseholdVehicle {
  id          String      @id @default(uuid()) @db.Uuid
  societyId   String      @db.Uuid
  householdId String      @db.Uuid
  plateNumber String
  vehicleType VehicleType
  make        String?
  model       String?
  color       String?
  active      Boolean     @default(true)
  createdAt   DateTime    @default(now())
  society     Society     @relation(fields: [societyId], references: [id], onDelete: Cascade)
  household   Household   @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([societyId, plateNumber])
  @@index([householdId, active])
}

model EmergencyContact {
  id          String    @id @default(uuid()) @db.Uuid
  societyId   String    @db.Uuid
  householdId String    @db.Uuid
  name        String
  phone       String
  relation    String?
  priority    Int       @default(1)
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  society     Society   @relation(fields: [societyId], references: [id], onDelete: Cascade)
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId, active, priority])
}

model DomesticWorker {
  id               String                           @id @default(uuid()) @db.Uuid
  societyId        String                           @db.Uuid
  name             String
  phone            String
  role             DomesticWorkerRole
  verification     DomesticWorkerVerificationStatus @default(PENDING)
  active           Boolean                          @default(true)
  createdAt        DateTime                         @default(now())
  updatedAt        DateTime                         @updatedAt
  society          Society                          @relation(fields: [societyId], references: [id], onDelete: Cascade)
  assignments      WorkforceAssignment[]
  ratings          WorkforceRating[]
  suspensionEvents WorkforceSuspensionEvent[]

  @@unique([societyId, phone])
  @@index([societyId, verification, active])
}

model WorkforceAssignment {
  id               String                     @id @default(uuid()) @db.Uuid
  societyId        String                     @db.Uuid
  householdId      String                     @db.Uuid
  workerId         String                     @db.Uuid
  status           WorkforceAssignmentStatus  @default(PENDING)
  schedule         Json                       @default("{}")
  active           Boolean                    @default(true)
  startDate        DateTime?
  endDate          DateTime?
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt
  society          Society                    @relation(fields: [societyId], references: [id], onDelete: Cascade)
  household        Household                  @relation(fields: [householdId], references: [id], onDelete: Cascade)
  worker           DomesticWorker             @relation(fields: [workerId], references: [id], onDelete: Cascade)
  leaves           WorkforceLeave[]
  rating           WorkforceRating?
  suspensionEvents WorkforceSuspensionEvent[]

  @@unique([householdId, workerId])
  @@index([societyId, status, active])
  @@index([societyId, workerId, active])
}

model WorkforceLeave {
  id           String              @id @default(uuid()) @db.Uuid
  societyId    String              @db.Uuid
  assignmentId String              @db.Uuid
  createdById  String              @db.Uuid
  startsOn     DateTime            @db.Date
  endsOn       DateTime            @db.Date
  reason       String?
  active       Boolean             @default(true)
  createdAt    DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime            @default(now()) @db.Timestamptz(6)
  society      Society             @relation(fields: [societyId], references: [id], onDelete: Cascade)
  assignment   WorkforceAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  createdBy    User                @relation("WorkforceLeaveCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([societyId, active, startsOn, endsOn], map: "WorkforceLeave_societyId_active_startsOn_endsOn_idx")
  @@index([assignmentId, active, startsOn, endsOn], map: "WorkforceLeave_assignmentId_active_startsOn_endsOn_idx")
}

model WorkforceRating {
  id           String              @id @default(uuid()) @db.Uuid
  societyId    String              @db.Uuid
  assignmentId String              @unique @db.Uuid
  workerId     String              @db.Uuid
  ratedById    String              @db.Uuid
  score        Int                 @db.SmallInt
  comment      String?
  createdAt    DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime            @default(now()) @db.Timestamptz(6)
  society      Society             @relation(fields: [societyId], references: [id], onDelete: Cascade)
  assignment   WorkforceAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  worker       DomesticWorker      @relation(fields: [workerId], references: [id], onDelete: Cascade)
  ratedBy      User                @relation("WorkforceRatingAuthor", fields: [ratedById], references: [id], onDelete: Restrict)

  @@index([societyId, workerId], map: "WorkforceRating_societyId_workerId_idx")
  @@index([societyId, score], map: "WorkforceRating_societyId_score_idx")
}

model WorkforceSuspensionEvent {
  id           String               @id @default(uuid()) @db.Uuid
  societyId    String               @db.Uuid
  workerId     String?              @db.Uuid
  assignmentId String?              @db.Uuid
  actorUserId  String               @db.Uuid
  action       String
  reason       String?
  occurredAt   DateTime             @default(now()) @db.Timestamptz(6)
  society      Society              @relation(fields: [societyId], references: [id], onDelete: Cascade)
  worker       DomesticWorker?      @relation(fields: [workerId], references: [id], onDelete: Cascade)
  assignment   WorkforceAssignment? @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  actor        User                 @relation("WorkforceSuspensionActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([societyId, occurredAt(sort: Desc)], map: "WorkforceSuspensionEvent_societyId_occurredAt_idx")
  @@index([workerId, occurredAt(sort: Desc)], map: "WorkforceSuspensionEvent_workerId_occurredAt_idx")
  @@index([assignmentId, occurredAt(sort: Desc)], map: "WorkforceSuspensionEvent_assignmentId_occurredAt_idx")
}

model Gate {
  id            String                @id @default(uuid()) @db.Uuid
  societyId     String                @db.Uuid
  name          String
  code          String
  active        Boolean               @default(true)
  society       Society               @relation(fields: [societyId], references: [id], onDelete: Cascade)
  auditEvents   AuditEvent[]
  gateMutations GateMutationReceipt[]

  @@unique([societyId, code])
}

model AccessRequest {
  id             String                @id @default(uuid()) @db.Uuid
  societyId      String                @db.Uuid
  unitId         String                @db.Uuid
  requestedById  String                @db.Uuid
  subjectType    AccessSubjectType
  subjectName    String
  subjectPhone   String?
  purpose        String?
  status         AccessRequestStatus   @default(PENDING)
  validFrom      DateTime?
  validUntil     DateTime?
  credentialHash String?
  enteredAt      DateTime?
  exitedAt       DateTime?
  metadata       Json                  @default("{}")
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  society        Society               @relation(fields: [societyId], references: [id], onDelete: Cascade)
  unit           Unit                  @relation(fields: [unitId], references: [id], onDelete: Cascade)
  requestedBy    User                  @relation(fields: [requestedById], references: [id], onDelete: Cascade)
  serviceBooking ServiceBooking?
  auditEvents    AuditEvent[]
  gateMutations  GateMutationReceipt[]

  @@index([societyId, unitId, status])
  @@index([societyId, requestedById, createdAt])
  @@index([societyId, credentialHash])
}

model ServiceCategory {
  id        String            @id @default(uuid()) @db.Uuid
  name      String
  slug      String            @unique
  active    Boolean           @default(true)
  sortOrder Int               @default(0)
  offerings ServiceOffering[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
}

model ServiceProvider {
  id           String                     @id @default(uuid()) @db.Uuid
  businessName String
  contactName  String?
  phone        String
  email        String?
  description  String?
  verification ProviderVerificationStatus @default(PENDING)
  active       Boolean                    @default(true)
  createdAt    DateTime                   @default(now())
  updatedAt    DateTime                   @updatedAt
  societies    ServiceProviderSociety[]
  offerings    ServiceOffering[]
  bookings     ServiceBooking[]
  ratings      ServiceRating[]

  @@index([verification, active])
}

model ServiceProviderSociety {
  id            String                @id @default(uuid()) @db.Uuid
  societyId     String                @db.Uuid
  providerId    String                @db.Uuid
  status        ProviderSocietyStatus @default(PENDING)
  commissionBps Int                   @default(1000)
  approvedAt    DateTime?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  society       Society               @relation(fields: [societyId], references: [id], onDelete: Cascade)
  provider      ServiceProvider       @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([societyId, providerId])
  @@index([societyId, status])
}

model ServiceOffering {
  id              String           @id @default(uuid()) @db.Uuid
  providerId      String           @db.Uuid
  categoryId      String           @db.Uuid
  name            String
  description     String?
  pricePaise      Int
  durationMinutes Int?
  active          Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  provider        ServiceProvider  @relation(fields: [providerId], references: [id], onDelete: Cascade)
  category        ServiceCategory  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  bookings        ServiceBooking[]

  @@index([categoryId, active])
  @@index([providerId, active])
}

model ServiceBooking {
  id                String               @id @default(uuid()) @db.Uuid
  societyId         String               @db.Uuid
  unitId            String               @db.Uuid
  residentUserId    String               @db.Uuid
  providerId        String               @db.Uuid
  offeringId        String               @db.Uuid
  accessRequestId   String?              @unique @db.Uuid
  status            ServiceBookingStatus @default(REQUESTED)
  scheduledFrom     DateTime
  scheduledUntil    DateTime
  servicePricePaise Int
  commissionBps     Int
  commissionPaise   Int
  notes             String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  society           Society              @relation(fields: [societyId], references: [id], onDelete: Cascade)
  unit              Unit                 @relation(fields: [unitId], references: [id], onDelete: Cascade)
  residentUser      User                 @relation(fields: [residentUserId], references: [id], onDelete: Cascade)
  provider          ServiceProvider      @relation(fields: [providerId], references: [id], onDelete: Restrict)
  offering          ServiceOffering      @relation(fields: [offeringId], references: [id], onDelete: Restrict)
  accessRequest     AccessRequest?       @relation(fields: [accessRequestId], references: [id], onDelete: SetNull)
  rating            ServiceRating?

  @@index([societyId, residentUserId, createdAt])
  @@index([societyId, providerId, status])
}

model ServiceRating {
  id             String          @id @default(uuid()) @db.Uuid
  societyId      String          @db.Uuid
  bookingId      String          @unique @db.Uuid
  providerId     String          @db.Uuid
  residentUserId String          @db.Uuid
  score          Int
  comment        String?
  createdAt      DateTime        @default(now())
  society        Society         @relation(fields: [societyId], references: [id], onDelete: Cascade)
  booking        ServiceBooking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  provider       ServiceProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  residentUser   User            @relation(fields: [residentUserId], references: [id], onDelete: Cascade)

  @@index([providerId, createdAt])
  @@index([societyId, createdAt])
}

model Visitor {
  id         String        @id @default(uuid()) @db.Uuid
  societyId  String        @db.Uuid
  unitId     String        @db.Uuid
  hostUserId String        @db.Uuid
  name       String
  phone      String?
  purpose    String?
  status     VisitorStatus @default(PENDING)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  society    Society       @relation(fields: [societyId], references: [id], onDelete: Cascade)
  unit       Unit          @relation(fields: [unitId], references: [id], onDelete: Cascade)
  hostUser   User          @relation(fields: [hostUserId], references: [id], onDelete: Cascade)
  passes     VisitorPass[]

  @@index([societyId, hostUserId])
  @@index([societyId, unitId])
}

model VisitorPass {
  id             String            @id @default(uuid()) @db.Uuid
  societyId      String            @db.Uuid
  visitorId      String            @db.Uuid
  credentialHash String
  validFrom      DateTime
  validUntil     DateTime
  status         VisitorPassStatus @default(ACTIVE)
  checkedInAt    DateTime?
  checkedOutAt   DateTime?
  createdAt      DateTime          @default(now())
  society        Society           @relation(fields: [societyId], references: [id], onDelete: Cascade)
  visitor        Visitor           @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  auditEvents    AuditEvent[]

  @@index([societyId, status])
  @@index([visitorId])
  @@index([societyId, credentialHash])
}

model AuditEvent {
  id              String         @id @default(uuid()) @db.Uuid
  societyId       String         @db.Uuid
  actorUserId     String         @db.Uuid
  gateId          String?        @db.Uuid
  visitorPassId   String?        @db.Uuid
  accessRequestId String?        @db.Uuid
  event           AuditEventType
  occurredAt      DateTime       @default(now())
  society         Society        @relation(fields: [societyId], references: [id], onDelete: Cascade)
  gate            Gate?          @relation(fields: [gateId], references: [id], onDelete: SetNull)
  visitorPass     VisitorPass?   @relation(fields: [visitorPassId], references: [id], onDelete: SetNull)
  accessRequest   AccessRequest? @relation(fields: [accessRequestId], references: [id], onDelete: SetNull)

  @@index([societyId, occurredAt])
  @@index([societyId, gateId, occurredAt])
  @@index([societyId, visitorPassId, occurredAt])
  @@index([societyId, accessRequestId, occurredAt])
}

model GateMutationReceipt {
  id              String             @id @default(uuid()) @db.Uuid
  societyId       String             @db.Uuid
  gateId          String             @db.Uuid
  accessRequestId String             @db.Uuid
  actorUserId     String             @db.Uuid
  idempotencyKey  String
  action          GateMutationAction
  createdAt       DateTime           @default(now())
  society         Society            @relation(fields: [societyId], references: [id], onDelete: Cascade)
  gate            Gate               @relation(fields: [gateId], references: [id], onDelete: Cascade)
  accessRequest   AccessRequest      @relation(fields: [accessRequestId], references: [id], onDelete: Cascade)

  @@unique([societyId, idempotencyKey])
  @@index([societyId, gateId, createdAt])
  @@index([accessRequestId, createdAt])
}

model DevicePushToken {
  id         String         @id @default(uuid()) @db.Uuid
  societyId  String         @db.Uuid
  userId     String         @db.Uuid
  token      String         @unique
  platform   DevicePlatform
  deviceId   String?
  active     Boolean        @default(true)
  lastSeenAt DateTime       @default(now())
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  society    Society        @relation(fields: [societyId], references: [id], onDelete: Cascade)
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([societyId, userId, active])
  @@index([userId, active])
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  societyId        String?   @db.Uuid
  accessTokenHash  String    @unique
  refreshTokenHash String    @unique
  expiresAt        DateTime
  refreshExpiresAt DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  society          Society?  @relation(fields: [societyId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([societyId, revokedAt])
  @@index([expiresAt])
  @@index([refreshExpiresAt])
}

model HelpdeskTicket {
  id           String             @id @default(uuid()) @db.Uuid
  societyId    String             @db.Uuid
  unitId       String             @db.Uuid
  createdById  String             @db.Uuid
  title        String
  description  String
  category     String?
  priority     String             @default("NORMAL")
  status       String             @default("OPEN")
  assignedToId String?            @db.Uuid
  resolvedAt   DateTime?          @db.Timestamptz(6)
  closedAt     DateTime?          @db.Timestamptz(6)
  createdAt    DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime           @default(now()) @db.Timestamptz(6)
  society      Society            @relation(fields: [societyId], references: [id], onDelete: Cascade)
  unit         Unit               @relation(fields: [unitId], references: [id], onDelete: Cascade)
  createdBy    User               @relation("HelpdeskTicketCreator", fields: [createdById], references: [id], onDelete: Cascade)
  assignedTo   User?              @relation("HelpdeskTicketAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  activities   HelpdeskActivity[]

  @@index([societyId, status, createdAt(sort: Desc)], map: "HelpdeskTicket_society_status_created_idx")
  @@index([societyId, createdById, createdAt(sort: Desc)], map: "HelpdeskTicket_society_creator_created_idx")
  @@index([societyId, unitId, createdAt(sort: Desc)], map: "HelpdeskTicket_society_unit_created_idx")
}

model HelpdeskActivity {
  id          String         @id @default(uuid()) @db.Uuid
  societyId   String         @db.Uuid
  ticketId    String         @db.Uuid
  actorUserId String         @db.Uuid
  type        String
  message     String?
  fromStatus  String?
  toStatus    String?
  occurredAt  DateTime       @default(now()) @db.Timestamptz(6)
  society     Society        @relation(fields: [societyId], references: [id], onDelete: Cascade)
  ticket      HelpdeskTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actor       User           @relation(fields: [actorUserId], references: [id], onDelete: Cascade)

  @@index([ticketId, occurredAt], map: "HelpdeskActivity_ticket_time_idx")
  @@index([societyId, occurredAt(sort: Desc)], map: "HelpdeskActivity_society_time_idx")
}

model Notice {
  id          String        @id @default(uuid()) @db.Uuid
  societyId   String        @db.Uuid
  createdById String        @db.Uuid
  title       String
  body        String
  category    String?
  status      String        @default("DRAFT")
  publishedAt DateTime?     @db.Timestamptz(6)
  expiresAt   DateTime?     @db.Timestamptz(6)
  archivedAt  DateTime?     @db.Timestamptz(6)
  createdAt   DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime      @default(now()) @db.Timestamptz(6)
  society     Society       @relation(fields: [societyId], references: [id], onDelete: Cascade)
  createdBy   User          @relation("NoticeCreator", fields: [createdById], references: [id], onDelete: Cascade)
  events      NoticeEvent[]

  @@index([societyId, status, publishedAt(sort: Desc)], map: "Notice_society_status_published_idx")
  @@index([societyId, createdAt(sort: Desc)], map: "Notice_society_created_idx")
}

model NoticeEvent {
  id          String   @id @default(uuid()) @db.Uuid
  societyId   String   @db.Uuid
  noticeId    String   @db.Uuid
  actorUserId String   @db.Uuid
  action      String
  fromStatus  String?
  toStatus    String?
  occurredAt  DateTime @default(now()) @db.Timestamptz(6)
  society     Society  @relation(fields: [societyId], references: [id], onDelete: Cascade)
  notice      Notice   @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  actor       User     @relation(fields: [actorUserId], references: [id], onDelete: Cascade)

  @@index([noticeId, occurredAt], map: "NoticeEvent_notice_time_idx")
  @@index([societyId, occurredAt(sort: Desc)], map: "NoticeEvent_society_time_idx")
}

model MaintenanceInvoice {
  id            String        @id @default(uuid()) @db.Uuid
  societyId     String        @db.Uuid
  unitId        String        @db.Uuid
  createdById   String        @db.Uuid
  invoiceNumber String
  billingPeriod String
  description   String?
  amountPaise   Int
  dueDate       DateTime      @db.Date
  status        InvoiceStatus @default(ISSUED)
  issuedAt      DateTime      @default(now()) @db.Timestamptz(6)
  paidAt        DateTime?     @db.Timestamptz(6)
  createdAt     DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime      @updatedAt @db.Timestamptz(6)
  society       Society       @relation(fields: [societyId], references: [id], onDelete: Cascade)
  unit          Unit          @relation(fields: [unitId], references: [id], onDelete: Restrict)
  createdBy     User          @relation("InvoiceCreator", fields: [createdById], references: [id], onDelete: Restrict)
  payments      Payment[]

  @@unique([societyId, invoiceNumber])
  @@index([societyId, unitId, status, dueDate])
}

model Payment {
  id                String             @id @default(uuid()) @db.Uuid
  societyId         String             @db.Uuid
  invoiceId         String             @db.Uuid
  payerUserId       String             @db.Uuid
  idempotencyKey    String
  provider          String
  providerOrderId   String             @unique
  providerPaymentId String?
  amountPaise       Int
  status            PaymentStatus      @default(CREATED)
  failureCode       String?
  createdAt         DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime           @updatedAt @db.Timestamptz(6)
  completedAt       DateTime?          @db.Timestamptz(6)
  society           Society            @relation(fields: [societyId], references: [id], onDelete: Cascade)
  invoice           MaintenanceInvoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  events            PaymentEvent[]

  @@unique([societyId, payerUserId, idempotencyKey])
  @@index([societyId, invoiceId, status])
}

model PaymentEvent {
  id              String   @id @default(uuid()) @db.Uuid
  societyId       String   @db.Uuid
  paymentId       String   @db.Uuid
  actorUserId     String?  @db.Uuid
  providerEventId String?  @unique
  type            String
  payloadDigest   String?
  occurredAt      DateTime @default(now()) @db.Timestamptz(6)
  society         Society  @relation(fields: [societyId], references: [id], onDelete: Cascade)
  payment         Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  actorUser       User?    @relation("PaymentEventActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([societyId, paymentId, occurredAt])
}

model SosIncident {
  id               String             @id @default(uuid()) @db.Uuid
  societyId        String             @db.Uuid
  unitId           String             @db.Uuid
  residentUserId   String             @db.Uuid
  status           SosStatus          @default(ACTIVE)
  message          String?
  latitude         Float?
  longitude        Float?
  acknowledgedById String?            @db.Uuid
  acknowledgedAt   DateTime?          @db.Timestamp(3)
  resolvedById     String?            @db.Uuid
  resolvedAt       DateTime?          @db.Timestamp(3)
  cancelledAt      DateTime?          @db.Timestamp(3)
  createdAt        DateTime           @default(now()) @db.Timestamp(3)
  updatedAt        DateTime           @default(now()) @db.Timestamp(3)
  society          Society            @relation(fields: [societyId], references: [id], onDelete: Cascade)
  unit             Unit               @relation(fields: [unitId], references: [id], onDelete: Cascade)
  resident         User               @relation("SosResident", fields: [residentUserId], references: [id], onDelete: Cascade)
  acknowledgedBy   User?              @relation("SosAcknowledgedBy", fields: [acknowledgedById], references: [id], onDelete: SetNull)
  resolvedBy       User?              @relation("SosResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)
  events           SosIncidentEvent[]

  @@index([societyId, status, createdAt], map: "SosIncident_societyId_status_createdAt_idx")
  @@index([societyId, residentUserId, createdAt], map: "SosIncident_societyId_residentUserId_createdAt_idx")
}

model SosIncidentEvent {
  id          String      @id @default(uuid()) @db.Uuid
  societyId   String      @db.Uuid
  incidentId  String      @db.Uuid
  actorUserId String      @db.Uuid
  action      String
  fromStatus  SosStatus?
  toStatus    SosStatus?
  note        String?
  occurredAt  DateTime    @default(now()) @db.Timestamp(3)
  society     Society     @relation(fields: [societyId], references: [id], onDelete: Cascade)
  incident    SosIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  actor       User        @relation(fields: [actorUserId], references: [id], onDelete: Cascade)

  @@index([societyId, incidentId, occurredAt], map: "SosIncidentEvent_societyId_incidentId_occurredAt_idx")
}

