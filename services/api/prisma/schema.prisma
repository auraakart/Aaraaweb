generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String              @id @default(uuid()) @db.Uuid
  phone       String              @unique
  email       String?             @unique
  name        String?
  status      UserStatus          @default(ACTIVE)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  memberships SocietyMembership[]
  unitLinks   UnitResident[]
  visitors    Visitor[]
  sessions    Session[]
}

model Society {
  id                String              @id @default(uuid()) @db.Uuid
  name              String
  code              String              @unique
  status            SocietyStatus       @default(ACTIVE)
  productTier       ProductTier         @default(STARTER)
  featureOverrides  Json                @default("{}")
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  memberships       SocietyMembership[]
  buildings         Building[]
  gates             Gate[]
  unitLinks         UnitResident[]
  households        Household[]
  vehicles          HouseholdVehicle[]
  emergencyContacts EmergencyContact[]
  visitors          Visitor[]
  visitorPasses     VisitorPass[]
  auditEvents       AuditEvent[]
  sessions          Session[]
}

model SocietyMembership {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  societyId String   @db.Uuid
  role      MembershipRole
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  society   Society  @relation(fields: [societyId], references: [id], onDelete: Cascade)
  @@unique([userId, societyId, role])
  @@index([societyId])
}

model Building {
  id        String   @id @default(uuid()) @db.Uuid
  societyId String   @db.Uuid
  name      String
  code      String
  society   Society  @relation(fields: [societyId], references: [id], onDelete: Cascade)
  units     Unit[]
  @@unique([societyId, code])
}

model Unit {
  id         String         @id @default(uuid()) @db.Uuid
  societyId  String         @db.Uuid
  buildingId String         @db.Uuid
  number     String
  building   Building       @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  residents  UnitResident[]
  household  Household?
  visitors   Visitor[]
  @@unique([buildingId, number])
  @@index([societyId])
}

model UnitResident {
  id        String   @id @default(uuid()) @db.Uuid
  societyId String   @db.Uuid
  unitId    String   @db.Uuid
  userId    String   @db.Uuid
  relation  UnitRelation
  primary   Boolean  @default(false)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  society   Society  @relation(fields: [societyId], references: [id], onDelete: Cascade)
  unit      Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([unitId, userId])
  @@index([societyId, unitId])
  @@index([societyId, userId])
}

model Household {
  id                String              @id @default(uuid()) @db.Uuid
  societyId         String              @db.Uuid
  unitId            String              @unique @db.Uuid
  displayName       String?
  accessPreferences Json                @default("{}")
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  society           Society             @relation(fields: [societyId], references: [id], onDelete: Cascade)
  unit              Unit                @relation(fields: [unitId], references: [id], onDelete: Cascade)
  vehicles          HouseholdVehicle[]
  emergencyContacts EmergencyContact[]
  @@index([societyId])
}

model HouseholdVehicle {
  id          String      @id @default(uuid()) @db.Uuid
  societyId   String      @db.Uuid
  householdId String      @db.Uuid
  plateNumber String
  vehicleType VehicleType
  make         String?
  model        String?
  color        String?
  active       Boolean     @default(true)
  createdAt    DateTime    @default(now())
  society      Society     @relation(fields: [societyId], references: [id], onDelete: Cascade)
  household    Household   @relation(fields: [householdId], references: [id], onDelete: Cascade)
  @@unique([societyId, plateNumber])
  @@index([householdId, active])
}

model EmergencyContact {
  id          String    @id @default(uuid()) @db.Uuid
  societyId   String    @db.Uuid
  householdId String    @db.Uuid
  name        String
  phone       String
  relation    String?
  priority    Int       @default(1)
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  society     Society   @relation(fields: [societyId], references: [id], onDelete: Cascade)
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  @@index([householdId, active, priority])
}

model Gate {
  id          String       @id @default(uuid()) @db.Uuid
  societyId   String       @db.Uuid
  name        String
  code        String
  active      Boolean      @default(true)
  society     Society      @relation(fields: [societyId], references: [id], onDelete: Cascade)
  auditEvents AuditEvent[]
  @@unique([societyId, code])
}

model Visitor {
  id         String        @id @default(uuid()) @db.Uuid
  societyId  String        @db.Uuid
  unitId     String        @db.Uuid
  hostUserId String        @db.Uuid
  name       String
  phone      String?
  purpose    String?
  status     VisitorStatus @default(PENDING)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  society    Society       @relation(fields: [societyId], references: [id], onDelete: Cascade)
  unit       Unit          @relation(fields: [unitId], references: [id], onDelete: Cascade)
  hostUser   User          @relation(fields: [hostUserId], references: [id], onDelete: Cascade)
  passes     VisitorPass[]
  @@index([societyId, hostUserId])
  @@index([societyId, unitId])
}

model VisitorPass {
  id             String            @id @default(uuid()) @db.Uuid
  societyId      String            @db.Uuid
  visitorId      String            @db.Uuid
  credentialHash String
  validFrom      DateTime
  validUntil     DateTime
  status         VisitorPassStatus @default(ACTIVE)
  checkedInAt    DateTime?
  checkedOutAt   DateTime?
  createdAt      DateTime          @default(now())
  society        Society           @relation(fields: [societyId], references: [id], onDelete: Cascade)
  visitor        Visitor           @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  auditEvents    AuditEvent[]
  @@index([societyId, status])
  @@index([visitorId])
  @@index([societyId, credentialHash])
}

model AuditEvent {
  id            String         @id @default(uuid()) @db.Uuid
  societyId     String         @db.Uuid
  actorUserId   String         @db.Uuid
  gateId        String         @db.Uuid
  visitorPassId String         @db.Uuid
  event         AuditEventType
  occurredAt    DateTime       @default(now())
  society       Society        @relation(fields: [societyId], references: [id], onDelete: Cascade)
  gate          Gate           @relation(fields: [gateId], references: [id], onDelete: Cascade)
  visitorPass   VisitorPass    @relation(fields: [visitorPassId], references: [id], onDelete: Cascade)
  @@index([societyId, occurredAt])
  @@index([societyId, gateId, occurredAt])
  @@index([societyId, visitorPassId, occurredAt])
}

model Session {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @db.Uuid
  societyId        String?  @db.Uuid
  accessTokenHash  String   @unique
  refreshTokenHash String   @unique
  expiresAt        DateTime
  refreshExpiresAt DateTime
  revokedAt        DateTime?
  createdAt        DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  society          Society? @relation(fields: [societyId], references: [id], onDelete: Cascade)
  @@index([userId, revokedAt])
  @@index([societyId, revokedAt])
  @@index([expiresAt])
  @@index([refreshExpiresAt])
}

enum UserStatus { ACTIVE SUSPENDED DELETED }
enum SocietyStatus { ACTIVE SUSPENDED }
enum ProductTier { STARTER PROFESSIONAL PREMIUM ENTERPRISE }
enum MembershipRole { SUPER_ADMIN SOCIETY_ADMIN COMMITTEE_MEMBER FACILITY_MANAGER ACCOUNTANT OWNER TENANT FAMILY_MEMBER SECURITY_SUPERVISOR SECURITY_GUARD STAFF VENDOR }
enum UnitRelation { OWNER TENANT FAMILY_MEMBER }
enum VehicleType { TWO_WHEELER CAR OTHER }
enum VisitorStatus { PENDING APPROVED DENIED CHECKED_IN CHECKED_OUT CANCELLED }
enum VisitorPassStatus { ACTIVE USED EXPIRED REVOKED }
enum AuditEventType { VISITOR_VERIFIED VISITOR_CHECKED_IN VISITOR_CHECKED_OUT }
