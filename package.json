{
  "name": "aaraagate",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "check:competitive-readiness": "node scripts/check-competitive-readiness.mjs",
    "check:api-contract": "node scripts/check-v4.36-api-contract.mjs",
    "check:v4.36": "node scripts/check-v4.36-architecture-convergence.mjs && node scripts/check-v4.36-api-contract.mjs",
    "check:v4.37": "node scripts/check-v4.37-repository-integrity.mjs",
    "check:v4.40": "node scripts/check-v4.40-stabilization.mjs"
  },
  "pnpm": {
    "overrides": {
      "sharp": ">=0.35.0",
      "postcss": ">=8.5.18",
      "deepmerge-ts": ">=8.0.1",
      "multer": "2.3.0"
    }
  },
  "engines": {
    "node": ">=22 <23",
    "pnpm": ">=10 <11"
  }
}
